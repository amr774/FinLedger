NODE_ENV=production
BACKUP_DATABASE_URL=postgresql://finledger_backup:REPLACE_RANDOM_BACKUP_PASSWORD@private-db.example.com:5432/finledger?sslmode=verify-full&sslrootcert=/etc/finledger/database-ca.pem
BACKUP_KEY_FILE=/etc/finledger/backup-key-v1
BACKUP_DIRECTORY=/var/lib/finledger/backups/key-v1
# Restore-only operator shell (never the scheduled backup account):
# RESTORE_ADMIN_URL=postgresql://restore_operator:REPLACE_PASSWORD@isolated-db.example.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/finledger/database-ca.pem
# BACKUP_FILE=/var/lib/finledger/backups/key-v1/SELECT_ARCHIVE.flbk
