# Operator-only host environment. Never attach this to the API/worker container.
NODE_ENV=production
DATABASE_ADMIN_URL=postgresql://bootstrap_admin:REPLACE_ADMIN_PASSWORD@private-db.example.com:5432/finledger?sslmode=verify-full&sslrootcert=/etc/finledger/database-ca.pem
MIGRATION_DATABASE_URL=postgresql://finledger_migrator:REPLACE_RANDOM_MIGRATION_PASSWORD@private-db.example.com:5432/finledger?sslmode=verify-full&sslrootcert=/etc/finledger/database-ca.pem
RUNTIME_DATABASE_URL=postgresql://finledger_runtime:REPLACE_RANDOM_RUNTIME_PASSWORD@private-db.example.com:5432/finledger
BACKUP_DATABASE_URL=postgresql://finledger_backup:REPLACE_RANDOM_BACKUP_PASSWORD@private-db.example.com:5432/finledger?sslmode=verify-full&sslrootcert=/etc/finledger/database-ca.pem
