PUBLIC_DOMAIN=ledger.example.com
ACME_EMAIL=operator@example.com
RUNTIME_DATABASE_URL=postgresql://finledger_runtime:REPLACE_RANDOM_RUNTIME_PASSWORD@private-db.example.com:5432/finledger
MIGRATION_DATABASE_URL=postgresql://finledger_migrator:REPLACE_RANDOM_MIGRATION_PASSWORD@private-db.example.com:5432/finledger?sslmode=verify-full&sslrootcert=/run/secrets/database-ca.pem
JWT_SECRET=REPLACE_WITH_48_OR_MORE_RANDOM_CHARACTERS
MONITORING_TOKEN=REPLACE_WITH_A_DIFFERENT_48_CHARACTER_SECRET
REDIS_URL=rediss://default:REPLACE_REDIS_PASSWORD@private-redis.example.com:6380/0
RABBITMQ_URL=amqps://finledger:REPLACE_BROKER_PASSWORD@private-rabbit.example.com:5671/finledger
# Copy real CA bundles into secrets/database-ca.pem and secrets/services-ca.pem.
# Copy MONITORING_TOKEN alone into secrets/monitoring-token (no newline required).
# Runtime never receives MIGRATION_DATABASE_URL. No infrastructure ports are published.
